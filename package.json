{
  "name": "crm-mentoria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-dev.mjs",
    "dev": "node scripts/start-crm.mjs --dev",
    "build": "next build",
    "start": "node scripts/start-crm.mjs",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prospecting:start": "node scripts/start-prospecting.mjs",
    "prospecting:engine": "docker compose -f services/prospecting/docker-compose.yml up -d",
    "prospecting:receita:download": "python3 services/prospecting/scripts/download_receita.py",
    "prospecting:receita:check": "node scripts/check-receita-local.mjs",
    "prospecting:receita:import": "python3 services/prospecting/painel/receita.py",
    "prospecting:test": "python3 -m unittest discover -s services/prospecting/painel -p 'test_*.py'",
    "db:local": "node scripts/setup-local-db.mjs",
    "whatsapp:local": "node scripts/setup-whatsapp.mjs",
    "asaas:check-outbound": "node scripts/check-asaas-outbound.mjs",
    "asaas:test": "node --test scripts/test-asaas-import.mjs",
    "whatsapp:test": "node --test scripts/test-whatsapp.mjs",
    "google-calendar:test": "node --test scripts/test-google-calendar.mjs",
    "google-calendar:check": "node scripts/check-google-calendar-local.mjs",
    "google-calendar:check-actions": "node scripts/check-google-calendar-actions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/test-*.mjs",
    "crm:check": "node scripts/check-crm-foundation.mjs",
    "sales:check": "node scripts/check-sales-cycle.mjs",
    "auth:check": "node scripts/check-auth-local.mjs",
    "asaas:check-webhook": "node scripts/check-asaas-webhook.mjs",
    "readiness:check": "node scripts/check-readiness.mjs",
    "hermes:test": "python3 -m unittest discover -s integrations/hermes/trackfor-crm -p test_plugin.py",
    "whatsapp:check-ai": "node scripts/check-whatsapp-ai.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "forms:prepare": "node scripts/prepare-contact-form.mjs",
    "db:backup-check": "node scripts/check-backup-local.mjs",
    "fiscal:process": "node scripts/process-fiscal-jobs.mjs",
    "fiscal:worker": "node scripts/process-fiscal-jobs.mjs --watch",
    "fiscal:check": "node scripts/check-fiscal-automatic.mjs",
    "webhooks:process": "node scripts/process-webhooks.mjs",
    "webhooks:worker": "node scripts/process-webhooks.mjs --watch",
    "access-media-webhooks:check": "node scripts/check-access-media-webhooks.mjs",
    "commercial:check": "node scripts/check-commercial-api.mjs",
    "whatsapp:check-reconnect": "node scripts/check-whatsapp-reconnect.mjs",
    "whatsapp:check-intake": "node scripts/check-whatsapp-intake.mjs",
    "whatsapp:triage": "node scripts/process-whatsapp-intake.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "0.25.12",
    "imapflow": "^2.11.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
