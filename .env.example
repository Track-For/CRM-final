# Copie para .env.local. Para Docker local prefira npm run db:local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
CRM_PUBLIC_URL=
# Mesmo domínio HTTPS do CRM para links de cobrança enviados pelo servidor.
NEXT_PUBLIC_APP_URL=
# Configure no provedor de hospedagem; não use credenciais fictícias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Válido somente com next dev; produção ignora a pausa.
LOCAL_LOGIN_PAUSED=false
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_TOKEN=
PROSPECTING_URL=http://127.0.0.1:8091
PROSPECTING_TOKEN=

# Assistente de conversas WhatsApp (somente servidor; nunca NEXT_PUBLIC_)
# Defina um modelo da sua conta compatível com Responses + Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
