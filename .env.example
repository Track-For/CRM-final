# Copie para .env.local. Para Docker local prefira npm run db:local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
CRM_PUBLIC_URL=
# Mesmo domínio HTTPS do CRM para links de cobrança enviados pelo servidor.
NEXT_PUBLIC_APP_URL=
# Configure no provedor de hospedagem; não use credenciais fictícias.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Cópia dos e-mails comerciais em Enviados (Hostinger detectada automaticamente).
# Por padrão usa SMTP_USER/SMTP_PASS. Configure IMAP_HOST para outros provedores.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Deixe vazio para detectar a pasta marcada como Enviados pelo servidor.
IMAP_SENT_FOLDER=
# false desativa a cópia (ex.: provedor que já salva os envios automaticamente).
EMAIL_SAVE_SENT=true
# Válido somente com next dev; produção ignora a pausa.
LOCAL_LOGIN_PAUSED=false
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_URL=
EVOLUTION_WEBHOOK_TOKEN=
PROSPECTING_URL=http://127.0.0.1:8091
PROSPECTING_TOKEN=

# Assistente de conversas WhatsApp (somente servidor; nunca NEXT_PUBLIC_)
# Defina um modelo da sua conta compatível com Responses, visão, arquivos e Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=

# Transcrição dos áudios recebidos no WhatsApp.
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# SaaS: domínio principal sem protocolo/porta; ex.: crm.suaempresa.com.br.
# Cada cliente acessa em cliente.crm.suaempresa.com.br (DNS e TLS wildcard).
# Em desenvolvimento: localhost -> cliente.localhost:3000.
SAAS_BASE_DOMAIN=
# Habilite somente depois de preparar banco, domínio e e-mails de acesso.
SAAS_REGISTRATION_ENABLED=false
# O serviço de prospecção mantém um processo/pasta por empresa ativa.
PROSPECTING_MAX_WORKSPACES=8
